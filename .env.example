# 복주 상담실 CRM
# 처음 셋업 시: cp .env.example .env  후 값 채우기

# 계정 초기 비밀번호 — admin·시드 계정을 처음 만들 때만 쓴다. 이후 바꾼 비밀번호는 재기동해도 유지된다.
APP_PASSWORD=changeme
# admin 비밀번호를 잊었을 때만: 1로 두고 재기동하면 admin 비밀번호·표시명·권한이 위 값/프리셋으로 되돌아간다.
# 로그인한 뒤 반드시 다시 지우고(또는 0) 재기동할 것 — 켜 둔 채로는 배포마다 초기화된다.
# APP_PASSWORD_RESET=0

# Flask 세션 서명용 키 — 64바이트 랜덤
# 생성: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-random-64-bytes-hex

# 서비스 포트
PORT=8003

# 백업 보관 디렉토리 (절대경로 권장). 컨테이너 배포 시 /backups (마운트 볼륨)
BACKUP_DIR=./backups
# 자동 백업 — 매일 지정 시각에 DB 스냅샷. 0으로 끄기
BACKUP_ENABLED=1
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=30

# 통합 인박스(/inbox) 표시 여부. 2026-09-10 기능 보류로 기본 0(숨김).
# 0이면 좌측 메뉴·통합검색·시작화면 선택지에서 사라지고 /inbox는 404가 된다.
# 미처리 인바운드 문의는 그동안 대시보드 '미처리 인바운드' 카드에서 처리한다.
INBOX_ENABLED=0

# DB 파일 경로. 비우면 코드 폴더 옆 bokju.db.
# 컨테이너 배포 시 /data/bokju.db (마운트 볼륨).
# 주의: NAS SMB 공유폴더 경로를 넣지 말 것 - SQLite WAL이 네트워크
#       파일시스템에서 동작하지 않아 동시 사용 시 데이터가 손상된다.
# BOKJU_DB_PATH=

# 동시 저장 대기 한도(초). 상담사 4명 규모면 기본값으로 충분.
BOKJU_DB_TIMEOUT=30

# 운영 서버(serve.py) 동시 처리 스레드 수
WAITRESS_THREADS=8

# 외부 LAN 접속 허용 여부 (기본 0=127.0.0.1만, 1=0.0.0.0)
ALLOW_LAN=0

# 자동 로그아웃 시간(시간) — 점심 자리비움 대비
SESSION_HOURS=4
# 자동 로그인 쿠키 유지 기간(일). 비밀번호 변경·계정 비활성화·로그아웃 시 무효화됩니다.
AUTO_LOGIN_DAYS=30

# 문자 발송 게이트웨이 (5번 기능) — 셋 다 채우면 클릭 한 번 자동 발송.
# 비워두면 'manual' 모드: 발송 이력만 기록하고 직원 휴대폰 문자앱을 연다.
# 지원 발송사: ppurio (뿌리오, 다우기술) / aligo (알리고). 다른 발송사는 sms.py _PROVIDERS에 어댑터 추가.
# 뿌리오는 연동관리에서 발송 서버(NAS) 공인 IP를 등록해야 401/403 없이 붙는다.
# SMS_PROVIDER=ppurio
# SMS_API_KEY=             # 뿌리오 '연동 개발 인증키' / 알리고 API key
# SMS_API_USER=            # 뿌리오 계정 / 알리고 user_id
# SMS_SENDER=              # 발송사에 사전 등록한 발신번호 (예: 0545501700)
# SMS_API_BASE=            # 선택. 발송사 API 호스트 재정의 (뿌리오 기본 https://message.ppurio.com)
# 테스트 전환 — 채우면 모든 문자가 이 번호로만 간다(보호자에게 안 나감). 연동 검증 뒤 비울 것.
# SMS_TEST_TO=

# ── 옴니채널 인바운드 webhook (직수신) ──
# 역프록시에서 /api/webhook/* 만 외부로 열고 나머지 CRM은 사내망 유지.
# 토큰이 비어 있으면 해당 채널은 비활성(503)이라 기본은 안전하다.
# 긴 랜덤값 권장:  python -c "import secrets;print(secrets.token_urlsafe(32))"
#
# 카카오 비즈채널 → /api/webhook/kakao (헤더 X-Webhook-Token 또는 ?token=)
# KAKAO_WEBHOOK_TOKEN=
#
# 홈페이지 문의폼 → /api/webhook/homepage (홈페이지 서버가 서버-투-서버로 POST)
# HOMEPAGE_WEBHOOK_TOKEN=
#
# (선택) 웹훅 허용 IP 화이트리스트 — 쉼표 구분. 설정 시 이 IP만 웹훅 호출 가능.
# 카카오/홈페이지 서버의 고정 IP를 넣으면 노출 위험이 크게 준다.
# WEBHOOK_ALLOW_IPS=

# ── 홈페이지 상담게시판 연동 (bokjurh.co.kr, homepage_board.py) ──
# 공개 목록을 3분마다 읽어 새 글을 인박스에 넣고(계정 없이도 동작), 관리자 계정이 있으면
# 본문·연락처를 채우고 인박스 '답변' 버튼으로 게시판에 답변까지 등록한다.
# 관리자 계정은 이 파일에만 두고 로그·감사에는 남기지 않는다.
HOMEPAGE_ADMIN_ID=
HOMEPAGE_ADMIN_PW=
# HOMEPAGE_BOARD_POLL_SECONDS=180
# HOMEPAGE_BOARD_ENABLED=1        # 0이면 연동 전체 정지

# ── EasyQR '빠른 전화상담 신청' 연동 (walk.induk.ai.kr, easyqr_inbox.py) ──
# 기획실이 열어 준 읽기 전용 JSON API(X-API-Key)를 3분마다 폴링해 새 접수를 인박스에 넣는다.
# 둘 다 설정돼야 활성. 미설정이면 조용히 비활성. 키·명세는 기획실(EasyQR_상담데이터_API명세.md).
# 컨테이너가 같은 NAS에 있으므로 내부 IP로 부른다(외부 도메인은 Cloudflare 경유라 느리고 UA 필요).
# EASYQR_API_URL=http://172.16.1.250/Developer/EasyQR/api/consult_export.php
# EASYQR_API_KEY=
# EASYQR_POLL_SECONDS=180
# 첫 기동은 '지금부터'(현재 최대 id 이후)만 가져온다. 과거분까지 넣으려면 그 id(0이면 전체)를 지정.
# 상태 파일(data/easyqr_sync_status.json)이 생긴 뒤에는 무시된다.
# EASYQR_BACKFILL_FROM=0

# ── 홈페이지 문의 메일 브릿지 (빌더형 홈페이지: 카페24·아임웹 등) ──
# 홈페이지가 '새 문의 접수 시 관리자 이메일 알림'을 보내면, 전용 메일함을
# 사내망 워커가 IMAP으로 읽어 인박스에 자동 등록한다(외부 포트 개방 불필요).
# 셋 다 설정돼야 활성. 미설정이면 조용히 비활성.
# IMAP_HOST=imap.naver.com
# IMAP_PORT=993
# IMAP_USER=inquiry@yourhospital.com
# IMAP_PASS=              # 메일 앱 비밀번호 권장
# IMAP_FOLDER=INBOX
# IMAP_POLL_SECONDS=120
# (선택) 빌더 알림 발신주소만 처리 — 엉뚱한 메일 무시
# IMAP_FROM_FILTER=no-reply@imweb.me

# AI 인사이트 모델 — 구조화 출력 지원 모델이어야 함 (미설정 시 claude-sonnet-5)
# CLAUDE_MODEL_INSIGHT=claude-sonnet-5

# ── 팩스·문서 자료함 (fax_inbox.py, docs/FAX-NAS-PLAN.md) ──
# 수신 담당 PC가 팩스 PDF를 저장하는 NAS 공유폴더. 컨테이너 안 경로로 적는다
# (docker-compose.yml volumes에 /volume1/<공유폴더>:/fax 를 함께 연다). 비우면 자료함 감시가 꺼진다.
# FAX_INBOX_DIR=/fax/수신
# 판독 후 '날짜_환자이름_주병명.pdf'로 옮겨 둘 폴더 (기본 <FAX_INBOX_DIR>/정리)
# FAX_ARCHIVE_DIR=/fax/정리
# FAX_POLL_SECONDS=60
# AI 판독(환자 이름·주병명·핵심 요약). 팩스 문서 자체가 Claude API로 나간다 — 병원 방침으로 끌 수 있다.
# FAX_AI_ENABLED=1
# CLAUDE_MODEL_FAX=claude-opus-5
# 보통 팩스(10~20장)는 통째로, 책 두께로 오면 앞 N쪽만 AI에 보낸다 — 환자·진단·의뢰 사유는 앞장에 있다. 파일은 통째로 보관.
# FAX_AI_MAX_PAGES=50
# 원본 보관 일수(기본 10일). 지나면 파일만 지우고 요약·판독값·환자 연결은 DB에 남긴다. 0이면 자동 삭제 없음. 매일 FAX_RETENTION_HOUR시 확인.
# FAX_KEEP_DAYS=10
# FAX_RETENTION_HOUR=4

# 심평원 병원 명부 자동 갱신 (hira_sync.py) — 공공데이터포털에서
# '건강보험심사평가원_병원정보서비스' 활용신청 후 받은 일반 인증키(Decoding).
# 비워 두면 조용히 건너뛴다. 환자 정보는 나가지 않고 공공 목록만 받아온다.
HIRA_SERVICE_KEY=
HIRA_SYNC_ENABLED=1
HIRA_SYNC_WEEKDAY=0      # 0=월 … 6=일
HIRA_SYNC_HOUR=6         # 백업(03시) 뒤, 업무 시작 전

# 공단 장기요양기관(요양원) 명부 자동 갱신 (ltci_sync.py) — 공공데이터포털에서
# '국민건강보험공단_장기요양기관 검색 서비스' 활용신청 후 받은 인증키(Decoding).
# 비워 두면 HIRA_SERVICE_KEY를 같이 쓴다(같은 포털 키지만 이 서비스도 활용신청이 따로 필요).
# 상담일지 '환자상태 → 요양원' 칸이 전국 입소시설(노인요양시설·공동생활가정) 공식명에서 찾는다.
LTCI_SERVICE_KEY=
LTCI_SYNC_ENABLED=1
LTCI_SYNC_WEEKDAY=0
LTCI_SYNC_HOUR=7         # 심평원(06시) 다음

# 차량 운행(픽업) 요청 → 운행팀 구글 시트 '운행 공유' 자동 기입 (transport.py)
# 설치 방법: docs/TRANSPORT-SHEET.md. URL이 비어 있으면 CRM 안에만 기록한다.
TRANSPORT_SHEET_URL=
TRANSPORT_SHEET_TOKEN=
TRANSPORT_SHEET_LINK=                     # 시트 주소(docs.google.com/spreadsheets/d/…) — 카드의 "운행 시트 열기" 링크. 비우면 스크립트 응답에서 자동
TRANSPORT_MOBILITY_OPTIONS=W/C,walk,Rec   # 시트 '이동수단' 드롭다운 값과 똑같이
TRANSPORT_SYNC_MINUTES=15                 # 전송 대기 재시도·배정자 읽기·배정 알림 주기

# 통화 녹음(LG헬로비전 biz070) 자동 로그인 — 둘 다 채우면 사이드바 '통화 녹음' 버튼이 새 탭에서
# 자동 로그인까지 한다(조회 전용 계정에는 적용 안 함). 비워 두면 녹음 사이트 링크로만 동작.
# 비밀번호 원문은 서버에만 있고 브라우저에는 SHA-256 해시로만 내려간다.
CALL_RECORDING_ID=
CALL_RECORDING_PASSWORD=
