# 복주 상담실 CRM
# 처음 셋업 시: cp .env.example .env  후 값 채우기

# 관리자 1회 셋업용 초기 비밀번호 (Phase 4에서 직원별 계정으로 분리)
APP_PASSWORD=changeme

# Flask 세션 서명용 키 — 64바이트 랜덤
# 생성: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-random-64-bytes-hex

# 서비스 포트
PORT=8003

# 백업 보관 디렉토리 (절대경로 권장). 컨테이너 배포 시 /backups (마운트 볼륨)
BACKUP_DIR=./backups
# 자동 백업 — 매일 지정 시각에 DB 스냅샷. 0으로 끄기
BACKUP_ENABLED=1
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=30

# DB 파일 경로. 비우면 코드 폴더 옆 bokju.db.
# 컨테이너 배포 시 /data/bokju.db (마운트 볼륨).
# 주의: NAS SMB 공유폴더 경로를 넣지 말 것 - SQLite WAL이 네트워크
#       파일시스템에서 동작하지 않아 동시 사용 시 데이터가 손상된다.
# BOKJU_DB_PATH=

# 동시 저장 대기 한도(초). 상담사 4명 규모면 기본값으로 충분.
BOKJU_DB_TIMEOUT=30

# 운영 서버(serve.py) 동시 처리 스레드 수
WAITRESS_THREADS=8

# 외부 LAN 접속 허용 여부 (기본 0=127.0.0.1만, 1=0.0.0.0)
ALLOW_LAN=0

# 자동 로그아웃 시간(시간) — 점심 자리비움 대비
SESSION_HOURS=4
# 자동 로그인 쿠키 유지 기간(일). 비밀번호 변경·계정 비활성화·로그아웃 시 무효화됩니다.
AUTO_LOGIN_DAYS=30

# 문자 발송 게이트웨이 (5번 기능) — 발송사 결정 후 입력하면 클릭 한 번 자동 발송.
# 비워두면 'manual' 모드: 발송 이력만 기록하고 직원 휴대폰 문자앱을 연다.
# 발송사 결정 시 sms.py의 send_sms()도 함께 구현해야 한다.
# SMS_API_KEY=
# SMS_SENDER=

# ── 옴니채널 인바운드 webhook (직수신) ──
# 역프록시에서 /api/webhook/* 만 외부로 열고 나머지 CRM은 사내망 유지.
# 토큰이 비어 있으면 해당 채널은 비활성(503)이라 기본은 안전하다.
# 긴 랜덤값 권장:  python -c "import secrets;print(secrets.token_urlsafe(32))"
#
# 카카오 비즈채널 → /api/webhook/kakao (헤더 X-Webhook-Token 또는 ?token=)
# KAKAO_WEBHOOK_TOKEN=
#
# 홈페이지 문의폼 → /api/webhook/homepage (홈페이지 서버가 서버-투-서버로 POST)
# HOMEPAGE_WEBHOOK_TOKEN=
#
# (선택) 웹훅 허용 IP 화이트리스트 — 쉼표 구분. 설정 시 이 IP만 웹훅 호출 가능.
# 카카오/홈페이지 서버의 고정 IP를 넣으면 노출 위험이 크게 준다.
# WEBHOOK_ALLOW_IPS=

# ── 홈페이지 문의 메일 브릿지 (빌더형 홈페이지: 카페24·아임웹 등) ──
# 홈페이지가 '새 문의 접수 시 관리자 이메일 알림'을 보내면, 전용 메일함을
# 사내망 워커가 IMAP으로 읽어 인박스에 자동 등록한다(외부 포트 개방 불필요).
# 셋 다 설정돼야 활성. 미설정이면 조용히 비활성.
# IMAP_HOST=imap.naver.com
# IMAP_PORT=993
# IMAP_USER=inquiry@yourhospital.com
# IMAP_PASS=              # 메일 앱 비밀번호 권장
# IMAP_FOLDER=INBOX
# IMAP_POLL_SECONDS=120
# (선택) 빌더 알림 발신주소만 처리 — 엉뚱한 메일 무시
# IMAP_FROM_FILTER=no-reply@imweb.me
