# 복주 상담실 CRM
# 처음 셋업 시: cp .env.example .env  후 값 채우기

# 관리자 1회 셋업용 초기 비밀번호 (Phase 4에서 직원별 계정으로 분리)
APP_PASSWORD=changeme

# Flask 세션 서명용 키 — 64바이트 랜덤
# 생성: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-random-64-bytes-hex

# 서비스 포트
PORT=8003

# 백업 보관 디렉토리 (절대경로 권장)
BACKUP_DIR=./backups

# 외부 LAN 접속 허용 여부 (기본 0=127.0.0.1만, 1=0.0.0.0)
ALLOW_LAN=0

# 자동 로그아웃 시간(시간) — 점심 자리비움 대비
SESSION_HOURS=4
